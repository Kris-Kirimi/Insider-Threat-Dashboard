# Copy this file to .env and fill in real values. Never commit .env.

# Django — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins for CORS/CSRF
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: full database URL (e.g. postgresql://user:pass@host/dbname).
# Leave empty to use local SQLite for development.
DATABASE_URL=

# Email for OTP delivery. Defaults to the console backend (OTP printed
# to the runserver terminal) — fine for development. For real email set:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Redis (broker, results, channels)
REDIS_URL=redis://localhost:6379/0
